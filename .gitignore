# Build output. Everything here is regenerated by CMake/Ninja, so it does not
# belong in the repository: the objects churn on every build and the binaries
# only bloat it. run.sh recreates the whole tree from scratch.
build/

# The icon generator is a small standalone CMake project; its build tree is
# generated exactly the same way and is regenerated by tools/mkico/README steps.
tools/mkico/build/

# Qt Creator's per-user session state. Machine-specific, and recreated by the
# IDE on open.
.qtcreator/

# Local Claude Code settings (per-machine permissions).
.claude/settings.local.json
